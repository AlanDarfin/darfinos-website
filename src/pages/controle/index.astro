---
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import { githubUrl } from '../../lib/config';
const features = [
  {number:'01',title:'Check before installing',desc:'Read-only Doctor, preflight and module checks. Verified complete steps can be skipped, while partial or unknown modules remain available.',label:'Safe inspection'},
  {number:'02',title:'Modular terminal installer',desc:'41 installation stages and six presets, with plan reviews, dependencies, execution history, progress and logs.',label:'Explicit execution'},
  {number:'03',title:'Package audit',desc:'Inspect part of the expected package inventory without assuming a package list proves a whole system stage is configured.',label:'Partial preview'},
  {number:'04',title:'Portable profiles',desc:'Export, import and compare JSON profiles to reuse choices. Imported profiles still require review.',label:'No automatic changes'},
  {number:'05',title:'Configuration backup',desc:'SHA-256 checked archives of allowlisted HOME configuration files, preview before restore and confirmation on overwrite.',label:'Limited recovery'},
  {number:'06',title:'Maintenance tools',desc:'Check Topgrade, Arch-Update, tray integrations and user timers without running updates silently.',label:'Opt-in actions'},
];
const commands=[
 {title:'Doctor and preflight',code:'python3 DarfinOSInstallScript-TUI.py --doctor\nbash DarfinOSInstallScript.sh --preflight',detail:'Verify the installer and basic requirements before executing stages.'},
 {title:'Installed module status',code:'python3 DarfinOSInstallScript-TUI.py --check-modules\nbash DarfinOSInstallScript.sh --check-modules',detail:'Installed, partial, missing and unknown results. Only verified installed stages are skipped.'},
 {title:'System and maintenance status',code:'python3 DarfinOSInstallScript-TUI.py --status-json\npython3 darfinos_control.py maintenance --json',detail:'Read-only inventory of tools, update helpers and maintenance infrastructure.'},
 {title:'Audit and compare presets',code:'python3 DarfinOSInstallScript-TUI.py --audit --preset gaming\npython3 DarfinOSInstallScript-TUI.py --compare-presets minimal gaming',detail:'Declarative comparison and partial package audit, without making changes.'},
];
const backups=[
{title:'Export and compare profiles',code:'python3 darfinos_control.py profile-export gaming gaming.json\npython3 darfinos_control.py profile-import gaming.json gaming-copy\npython3 darfinos_control.py profile-diff gaming gaming-copy'},
{title:'Back up configuration',code:'python3 darfinos_control.py backup ~/darfinos-config.zip'},
{title:'Review restore without applying',code:'python3 darfinos_control.py restore ~/darfinos-config.zip'},
{title:'Restore after explicit review',code:'python3 darfinos_control.py restore ~/darfinos-config.zip --apply --overwrite'},
];
---
<Base title="Control Center · DarfinOS" description="DarfinOS Control Center: 41 installer stages, module detection, Arch maintenance, JSON profiles and carefully scoped configuration backup.">
  <section class="grid-bg border-b border-white/10"><div class="max-w-6xl mx-auto px-5 py-16 md:py-24">
    <p class="section-kicker brand-kicker mb-6"><BrandMark class="h-5 w-5" /> // DARFINOS · CONTROL CENTER</p>
    <h1 class="section-heading max-w-4xl">Install deliberately.<br/><span class="text-electric">Keep control afterward.</span></h1>
    <p class="section-lead max-w-3xl mt-7">Tools to plan, inspect and maintain your opinionated Arch Linux customization. No new Linux distribution, no hidden system-wide changes.</p>
    <div class="flex flex-wrap gap-3 mt-8"><a class="btn btn-primary" href="#commands">See commands</a><a class="btn btn-outline" href="/docs/">Installation guide</a><a class="btn btn-outline" href="/labs/">Explore Labs</a></div>
    <p class="text-gray-400 text-sm mt-7">In development: automated checks passed, but full graphical VM and recovery testing remain open. No stable release is published.</p>
  </div></section>
  <section class="max-w-6xl mx-auto px-5 py-16 md:py-20">
    <p class="section-kicker mb-3">// FEATURES IN DEVELOPMENT</p><h2 class="section-heading mb-5">A tool for every stage of the project.</h2>
    <p class="section-lead mb-9">Features below exist in the current source. They are not a promise that every possible installation scenario has been validated.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">{features.map(feature => <article class="card feature-card flex flex-col gap-3">
      <div class="flex items-center justify-between gap-2"><span class="mono text-electric text-sm">{feature.number} /</span><span class="feature-label">{feature.label}</span></div>
      <h3 class="font-bold text-xl">{feature.title}</h3><p class="text-gray-400 text-sm leading-relaxed flex-1">{feature.desc}</p>
    </article>)}</div>
  </section>
  <section id="commands" class="bg-[#15171b] border-y border-white/10"><div class="max-w-6xl mx-auto px-5 py-16 md:py-20">
    <p class="section-kicker mb-3">// READ-ONLY TERMINAL COMMANDS</p><h2 class="section-heading mb-5">Understand your Arch before changing it.</h2>
    <p class="section-lead mb-9">Run these commands from the repository directory. None of these examples installs a package or requires sudo.</p>
    <div class="grid md:grid-cols-2 gap-5">{commands.map(item => <article class="card">
      <h3 class="font-bold text-lg">{item.title}</h3><p class="text-gray-400 text-sm mt-2">{item.detail}</p>
      <div class="code-panel"><pre><code>{item.code}</code></pre><button type="button" data-copy={item.code}>Copy</button></div>
    </article>)}</div>
    <p class="text-gray-400 text-sm mt-6">In the TUI, press <code>I</code> to refresh checks and <code>X</code> to force stage re-execution. The command-line equivalent is <code>--reinstall</code>. Pacman still respects <code>--needed</code>.</p>
  </div></section>
  <section class="max-w-6xl mx-auto px-5 py-16 md:py-20" id="profiles">
    <p class="section-kicker mb-3">// REPRODUCIBLE CHOICES</p><h2 class="section-heading mb-5">Profiles and limited recovery.</h2>
    <p class="section-lead mb-8">Save your selections, compare settings and protect selected configuration files. A HOME backup is not an operating system snapshot.</p>
    <div class="grid md:grid-cols-2 gap-5">{backups.map(item => <article class="card"><h3 class="font-bold text-lg">{item.title}</h3><div class="code-panel"><pre><code>{item.code}</code></pre><button type="button" data-copy={item.code}>Copy</button></div></article>)}</div>
    <div class="security-note mt-8"><strong>Limits:</strong> archives cover only allowlisted files in <code>~/.config</code>. They can contain private data. A restore does not undo pacman packages, modified services, changes under <code>/etc</code>, XLibre, SonicDE, Bedrock or boot changes. Always inspect the backup first.</div>
  </section>
  <section class="bg-[#15171b] border-y border-white/10"><div class="max-w-6xl mx-auto px-5 py-16 md:py-20">
    <p class="section-kicker mb-3">// RELEASE READINESS</p><h2 class="section-heading mb-6">What has been tested, and what's still missing?</h2>
    <div class="grid md:grid-cols-2 gap-5">
      <div class="card"><h3 class="text-xl font-bold">Automated checks</h3><p class="text-gray-400 text-sm mt-3">Python/Bash tests, packaging checks and safe smoke tests inside an Arch container. These checks do not perform a full XLibre/SonicDE desktop install.</p></div>
      <div class="card"><h3 class="text-xl font-bold">Still pending</h3><p class="text-gray-400 text-sm mt-3">Graphical session login/reboot, alternative environments, restore and boot recovery in a disposable VM. Development candidates are always marked as prereleases.</p></div>
    </div>
    <div class="flex flex-wrap gap-3 mt-8"><a class="btn btn-primary" href="/downloads/">Downloads and candidates</a><a class="btn btn-outline" href={githubUrl + '/actions'} target="_blank" rel="noopener noreferrer">CI on GitHub ↗</a></div>
  </div></section>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => button.addEventListener('click', async () => {
      if (!button.dataset.copy) return;
      try { await navigator.clipboard.writeText(button.dataset.copy); button.textContent = 'Copied!'; }
      catch { button.textContent = 'Select text'; }
    }));
  </script>
</Base>
