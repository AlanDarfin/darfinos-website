---
import Base from '../../layouts/Base.astro';
import { englishProjects, englishLabs } from '../../lib/english';
const groups = [
  {name:'System & desktop', ids:['Arch Linux','SonicDE','XLibre','CachyOS'],desc:'The Arch foundation, graphics stack and optional repositories that shape the system.'},
  {name:'Inspiration & experiments', ids:['Bedrock Linux','LinuxToys'],desc:'A high-impact integration experiment and the Linux tooling project that inspired DarfinOS.'},
];
---
<Base title="Tools and original projects · DarfinOS" description="Official links and credits for Arch Linux, SonicDE, XLibre, Bedrock, LinuxToys, Chicago95, i3 and the DarfinOS Labs.">
  <section class="grid-bg border-b border-white/10"><div class="max-w-6xl mx-auto px-5 py-16 md:py-20">
    <p class="section-kicker mb-4">// ECOSYSTEM & ORIGINAL AUTHORS</p>
    <h1 class="section-heading mb-5">Nothing gets built <span class="text-electric">in isolation.</span></h1>
    <p class="section-lead max-w-3xl">DarfinOS brings independent Linux tools together; it does not own or maintain them. Explore what each project actually does, and use its official links rather than copied downloads.</p>
  </div></section>
  <section class="max-w-6xl mx-auto px-5 py-16 md:py-20">
    {groups.map(group=><section class="mb-14">
      <p class="section-kicker mb-3">// {group.name.toUpperCase()}</p>
      <h2 class="section-heading mb-4">{group.name}</h2>
      <p class="text-gray-400 mb-7">{group.desc}</p>
      <div class="grid md:grid-cols-2 gap-5">{englishProjects.filter(p=>group.ids.includes(p.name)).map(project=><article class="card">
        <p class="section-kicker mb-2">{project.role}</p>
        <h3 class="text-xl font-bold mb-3">{project.name}</h3>
        <p class="text-gray-300 text-sm font-semibold mb-2">{project.summary}</p>
        <p class="text-gray-400 text-sm leading-relaxed">{project.description}</p>
        <div class="flex flex-wrap gap-3 mt-6"><a class="text-electric underline text-sm" href={project.url} target="_blank" rel="noopener noreferrer">Official website ↗</a>{project.sourceUrl&&<a class="text-electric underline text-sm" href={project.sourceUrl} target="_blank" rel="noopener noreferrer">Source code ↗</a>}</div>
      </article>)}</div>
    </section>)}
    <section class="mt-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-7">
        <div><p class="section-kicker mb-3">// DARFINOS LABS</p><h2 class="section-heading mb-4">Independent projects, original links.</h2><p class="section-lead">Thirteen additional experiments and tools, each credited to its upstream developer.</p></div>
        <a class="btn btn-primary self-start" href="/labs/">Explore the full Labs catalog ↗</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">{englishLabs.map(item=><article class="card flex flex-col gap-3">
        <p class="section-kicker text-xs">{item.step?'OPTIONAL STAGE':'MANUAL RESEARCH'}</p>
        <h3 class="text-lg font-bold">{item.name}</h3>
        <p class="text-gray-400 text-sm leading-relaxed flex-1">{item.description}</p>
        <a class="text-electric underline text-sm" href={item.originalUrl} target="_blank" rel="noopener noreferrer">Original project ↗</a>
      </article>)}</div>
    </section>
    <div class="security-note mt-10"><strong>Credit matters:</strong> Arch Linux, SonicDE, XLibre, Bedrock, LinuxToys and the projects in Labs are independent. DarfinOS is not officially affiliated with or endorsed by these teams.</div>
  </section>
</Base>
