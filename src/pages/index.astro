---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import { englishGallery, englishProjects } from '../lib/english';
import { labProjects } from '../lib/labs';
import { githubUrl, sourceZipUrl } from '../lib/config';
const features = [
 {num:'01',name:'Choose what runs',desc:'41 installer stages and six curated presets. Inspect dependencies and high-risk actions instead of blindly running everything.'},
 {num:'02',name:'Know what is installed',desc:'Conservative checks identify complete, partial, missing or unknown modules. Only verified complete modules are skipped.'},
 {num:'03',name:'Stay in control',desc:'A terminal UI with profiles, revision screens, history, recovery and maintenance, without forced automatic updates.'},
];
const galleryCategories = (src: string) => src.includes('terminal') || src.includes('tui') ? 'darfinos' : src.includes('linuxtoys') ? 'inspiration' : 'projects';
---
<Base title="DarfinOS · Your Arch, my rules." description="DarfinOS: my opinionated Arch Linux post-install toolkit, with a modular installer, XLibre, SonicDE, i3, Xfce, Chicago95 and experimental Linux Labs.">
  <section class="grid-bg relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-5 py-24 md:py-32 grid lg:grid-cols-2 items-center gap-12">
      <div>
        <p class="mono text-electric text-xs md:text-sm mb-5 tracking-widest brand-kicker"><BrandMark class="w-4 h-4 shrink-0"/> MODULAR ARCH LINUX CUSTOMIZATION</p>
        <h1 class="hero-title text-5xl md:text-7xl font-extrabold tracking-tight leading-tight">Your Arch,<br/><span class="text-electric">my rules.</span></h1>
        <p class="text-gray-300 text-lg mt-7 max-w-xl">A personal Arch Linux post-install project with carefully chosen tools, desktop options, unusual Linux experiments and a healthy suspicion of one-click installers.</p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a class="btn btn-primary" href="/downloads/">Get DarfinOS ↗</a>
          <a class="btn btn-outline" href="/docs/">Read the installation guide</a>
          <a class="btn btn-outline" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
        <p class="text-sm text-gray-400 mt-7">Arch Linux customization, not a separate ISO. Development candidates are not stable releases.</p>
      </div>
      <div class="card glow">
        <p class="section-kicker mb-4">// DARFINOS CONTROL CENTER</p>
        <div class="mono text-sm space-y-2">
          <p class="text-electric">$ python3 DarfinOSInstallScript-TUI.py --doctor</p>
          <p><span class="text-electric">✓</span> Inspect the installer before changing anything</p>
          <p class="text-electric mt-4">$ python3 DarfinOSInstallScript-TUI.py --check-modules</p>
          <p><span class="text-electric">✓</span> Check 41 module stages without sudo</p>
          <p class="text-electric mt-4">$ python3 DarfinOSInstallScript-TUI.py --plan --preset retro</p>
          <p><span class="text-electric">✓</span> Preview Xfce + Chicago95 without installing</p>
        </div>
        <div class="flex flex-wrap gap-3 mt-7">
          <a class="btn btn-primary" href="/controle/">Explore Control Center</a>
          <a class="btn btn-outline" href="/labs/">Discover Labs</a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 py-20" id="recursos">
    <p class="section-kicker mb-3">// PROJECT FEATURES</p>
    <h2 class="section-heading mb-6">My choices. <span class="text-electric">Your review.</span></h2>
    <p class="section-lead mb-9">DarfinOS makes Arch easier to shape without pretending every modification is harmless. Every installation step stays visible and optional.</p>
    <div class="grid md:grid-cols-3 gap-5">{features.map(feature => <article class="card feature-card"><p class="section-kicker mb-3">{feature.num} / FEATURE</p><h3 class="text-xl font-bold mb-3">{feature.name}</h3><p class="text-gray-400 text-sm">{feature.desc}</p></article>)}</div>
    <div class="grid grid-cols-3 gap-3 mt-9 text-center">
      <div class="card"><p class="text-3xl font-bold text-electric">41</p><p class="text-xs text-gray-400 mt-1">Installer stages</p></div>
      <div class="card"><p class="text-3xl font-bold text-electric">6</p><p class="text-xs text-gray-400 mt-1">Presets</p></div>
      <div class="card"><p class="text-3xl font-bold text-electric">13</p><p class="text-xs text-gray-400 mt-1">Independent Labs</p></div>
    </div>
  </section>

  <section id="controle" class="bg-[#15171b] border-y border-white/10">
    <div class="max-w-6xl mx-auto px-5 py-16 md:py-20">
      <p class="section-kicker mb-3">// NEW · CONTROL CENTER</p>
      <h2 class="section-heading mb-5">The project doesn't end <span class="text-electric">after installation.</span></h2>
      <p class="section-lead max-w-3xl">Inspect installed modules, audit package previews, compare reproducible presets, review maintenance tools and back up selected home configuration files.</p>
      <div class="flex flex-wrap gap-3 mt-7"><a class="btn btn-primary" href="/controle/">Control Center features ↗</a><a class="btn btn-outline" href="/docs/">Commands and safety notes</a></div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-5 py-20" id="labs">
    <p class="section-kicker mb-3">// DARFINOS LABS</p>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div><h2 class="section-heading mb-4">My Arch. My ideas.<br/><span class="text-electric">My experiments.</span></h2><p class="section-lead">An underground-leaning collection of independent projects, from tiling window managers to experiments in the Linux display stack.</p></div>
      <a href="/labs/" class="btn btn-primary self-start">See all 13 projects ↗</a>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {labProjects.filter(item => ['i3','chicago95','yserver'].includes(item.id)).map(project =>
        <article class="card feature-card">
          <p class="section-kicker mb-3">{project.step ? 'OPTIONAL INTEGRATION' : 'EXPERIMENTAL RESEARCH'}</p>
          <h3 class="text-xl font-bold mb-3">{project.name}</h3>
          <p class="text-gray-400 text-sm leading-relaxed flex-1">{project.id === 'chicago95' ? 'A Windows 95-inspired GTK and icon theme for the Xfce desktop. The Retro preset never changes your current desktop automatically.' : project.id === 'i3' ? 'A keyboard-driven X11 tiling window manager, available as a separate Arch/XLibre session.' : 'An experimental Rust X11 server, documented for isolated testing rather than automatic replacement.'}</p>
          <a class="text-electric underline text-sm mt-4 inline-block" href={project.originalUrl} target="_blank" rel="noopener noreferrer">Original project ↗</a>
        </article>)}
    </div>
  </section>

  <section id="galeria" class="max-w-6xl mx-auto px-5 py-20">
    <p class="section-kicker mb-3">// SYSTEM & PROJECT SCREENSHOTS</p>
    <h2 class="section-heading mb-5">A bit of my setup, and <span class="text-electric">the projects behind it.</span></h2>
    <p class="section-lead mb-7">Screenshots show DarfinOS tools as well as the independent projects they integrate or credit.</p>
    <div class="filter-bar mb-7" role="group" aria-label="Filter gallery">
      <button class="filter-btn is-active" data-gallery-filter="all" type="button" aria-pressed="true">All</button>
      <button class="filter-btn" data-gallery-filter="darfinos" type="button" aria-pressed="false">DarfinOS</button>
      <button class="filter-btn" data-gallery-filter="projects" type="button" aria-pressed="false">Projects</button>
      <button class="filter-btn" data-gallery-filter="inspiration" type="button" aria-pressed="false">Inspiration</button>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {englishGallery.map(item => <article class="card flex flex-col gap-3" data-gallery-card data-category={galleryCategories(item.src)}>
        <img src={item.src} alt={item.alt} loading="lazy" class="rounded-md w-full object-cover aspect-video" />
        <p class="section-kicker">{item.label}</p><h3 class="font-bold text-xl">{item.title}</h3>
        <p class="text-gray-400 text-sm flex-1 leading-relaxed">{item.caption}</p>
        <a href={item.url} class="text-electric underline text-sm" target="_blank" rel="noopener noreferrer">{item.linkText} ↗</a>
      </article>)}
    </div>
  </section>

  <section class="border-t border-white/10 bg-[#15171b]"><div class="max-w-6xl mx-auto px-5 py-16">
    <p class="section-kicker mb-3">// DOWNLOAD & GET STARTED</p><h2 class="section-heading mb-5">The source is available. <span class="text-electric">A stable release is not.</span></h2>
    <p class="section-lead mb-6">Download the latest source archive or check GitHub for pre-release development candidates with SHA-256 checksums. An ISO is not included.</p>
    <div class="flex flex-wrap gap-3"><a href={sourceZipUrl} class="btn btn-primary">Download main ZIP</a><a href="/downloads/" class="btn btn-outline">Release status and downloads</a></div>
  </div></section>
  <script>
    const controls = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-card]'));
    controls.forEach(control => control.addEventListener('click', () => {
      const filter = control.dataset.galleryFilter || 'all';
      controls.forEach(btn => { btn.classList.toggle('is-active', btn === control); btn.setAttribute('aria-pressed', String(btn === control)); });
      cards.forEach(card => { card.hidden = filter !== 'all' && card.dataset.category !== filter; });
    }));
  </script>
</Base>
