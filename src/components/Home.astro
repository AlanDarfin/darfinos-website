---
import BrandMark from './BrandMark.astro';
import { siteConfig, githubUrl, sourceZipUrl } from '../lib/config';
import { englishGallery } from '../lib/english';
interface Props { locale?: 'en' | 'pt-BR' }
const { locale = 'en' } = Astro.props;
const pt = locale === 'pt-BR';
const path = (route: string) => (pt ? '/pt-br' : '') + route;
const t = (en: string, br: string) => pt ? br : en;
const gallery = pt ? siteConfig.screenshots : englishGallery;
const tuiShot = gallery.find(shot => shot.src.endsWith('/tui.png'));
const labsRoute = path('/labs/');
const category = (shot: typeof gallery[number]) => ('category' in shot ? shot.category : undefined) || (/terminal|tui|control-center/.test(shot.src) ? 'darfinos' : shot.src.includes('linuxtoys') ? 'inspiration' : 'projects');
const filters = [
  { id: 'all', label: t('All images', 'Todas as imagens') },
  { id: 'darfinos', label: 'DarfinOS' },
  { id: 'projects', label: t('Independent projects', 'Projetos independentes') },
  { id: 'inspiration', label: t('Inspiration', 'Inspiração') },
];
const presets = [
  { name:'minimal', icon:'>_', tag:t('THE STARTING POINT', 'O PONTO DE PARTIDA'), title:t('Less, with intention.', 'Menos, com intenção.'), description:t('Core tools, hardware support, fonts and maintenance. A lean base to build on.', 'Ferramentas essenciais, suporte a hardware, fontes e manutenção. Uma base enxuta para começar.') },
  { name:'desktop', icon:'▤', tag:'SONICDE + XLIBRE', title:t('Make yourself at home.', 'Um desktop para chamar de seu.'), description:t('The SonicDE desktop, an X11 stack and everyday utilities, selected together.', 'O desktop SonicDE, a base gráfica X11 e os utilitários do dia a dia em uma seleção.') },
  { name:'gaming', icon:'✣', tag:t('DESKTOP + GAMES', 'DESKTOP + JOGOS'), title:t('Make room for play.', 'Espaço para jogar.'), description:t('The desktop selection with gaming tools. Review GPU support and package availability first.', 'Uma seleção de desktop com ferramentas para jogos. Confira o suporte à GPU e a disponibilidade dos pacotes.') },
  { name:'i3', icon:'▥', tag:t('KEYBOARD FIRST', 'TECLADO EM PRIMEIRO LUGAR'), title:t('Every window in its place.', 'Cada janela no seu lugar.'), description:t('i3 with XLibre for a tiling workflow. A separate choice that does not install SonicDE.', 'i3 com XLibre para organizar suas janelas em mosaico. Uma opção que não instala o SonicDE.') },
  { name:'retro', icon:'▣', tag:'XFCE + CHICAGO95', title:t('A familiar kind of nostalgia.', 'Uma boa dose de nostalgia.'), description:t('Xfce with optional Chicago95 themes and icons. Assets are copied after confirmation; applying the theme stays up to you.', 'Xfce com temas e ícones opcionais do Chicago95. Os arquivos são copiados após confirmação; você escolhe quando aplicar.') },
  { name:'workstation', icon:'▥', tag:'WORKSTATION 1995', title:t('Back to the workstation.', 'De volta à workstation.'), description:t('Window Maker as a parallel X11 session, with an optional graphite and gold profile.', 'Window Maker como sessão X11 paralela, com perfil grafite e amarelo opcional.') },
  { name:'full', icon:'*', tag:t('ADVANCED SELECTION', 'SELEÇÃO AVANÇADA'), title:t('Explore the whole toolkit.', 'Explore o conjunto completo.'), description:t('All conventional stages, including Bedrock. High-impact choices need review; optional Labs stay outside this preset.', 'Todas as etapas convencionais, incluindo Bedrock. Revise as opções de maior impacto; módulos Labs ficam fora deste preset.') },
];
const workflow = [
  { n:'01', key:'--doctor', title:t('Understand your system', 'Entenda seu sistema'), description:t('Inspect the installer structure and required tools before changing anything.', 'Confira a estrutura do instalador e as ferramentas necessárias antes de fazer mudanças.'), symbol:'⌕' },
  { n:'02', key:'--plan --preset minimal', title:t('Build your own plan', 'Monte seu plano'), description:t('Start with a preset, inspect dependencies and adjust the selected stages.', 'Comece com um preset, inspecione as dependências e ajuste as etapas selecionadas.'), symbol:'☷' },
  { n:'03', key:'--local', title:t('Review. Then run.', 'Revise. Depois execute.'), description:t('Confirm the changes in the TUI and follow progress, logs and execution history.', 'Confirme as alterações na TUI e acompanhe o progresso, os logs e o histórico.'), symbol:'→' },
];
---
<div class="home" data-home-gallery data-locale={locale}>
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="hero-grid home-container">
      <div class="hero-copy">
        <p class="home-eyebrow"><span class="status-dot" aria-hidden="true"></span>{t('ARCH LINUX. WITH PERSONALITY.', 'ARCH LINUX. COM PERSONALIDADE.')}</p>
        <h1 id="hero-heading">{t('Your Arch,', 'Seu Arch,')}<br/><span>{t('my rules.', 'minhas regras.')}</span></h1>
        <p class="hero-description">{t('My take on Arch Linux. A modular toolkit to shape your desktop, tune your terminal and try something a little different.', 'Meu jeito de usar o Arch Linux. Ferramentas modulares para dar forma ao desktop, personalizar o terminal e experimentar novos caminhos.')}</p>
        <div class="hero-actions"><a href={path('/downloads/')} class="btn btn-primary">{t('Get DarfinOS', 'Começar com DarfinOS')} <span aria-hidden="true">→</span></a><a href={path('/docs/')} class="hero-guide">{t('Read the guide', 'Ler a documentação')} <span aria-hidden="true">→</span></a></div>
        <p class="hero-disclaimer">{t('An Arch post-install project. Open source. In development.', 'Um projeto de pós-instalação do Arch. Código aberto. Em desenvolvimento.')}</p>
      </div>
      <figure class="hero-screen">
        <div class="screen-caption"><span class="home-eyebrow">DARFINOS / CONTROL CENTER</span><span class="screen-status">TUI V5</span></div>
        <a href="/screenshots/tui.png" class="screen-window" data-image-open data-image-title="DarfinOS Control Center" aria-label={t('Enlarge the current DarfinOS TUI screenshot', 'Ampliar a captura atual da TUI do DarfinOS')}>
          <div class="window-bar" aria-hidden="true"><span class="window-dots"><i></i><i></i><i></i></span><span>DarfinOSInstallScript-TUI.py</span><span>→</span></div>
          <img src="/screenshots/tui.png" alt={t('The current DarfinOS terminal interface with module selection, inspection and navigation', 'Interface atual do DarfinOS no terminal, com seleção de módulos, inspeção e navegação')} width={tuiShot && 'width' in tuiShot ? tuiShot.width : 1296} height={tuiShot && 'height' in tuiShot ? tuiShot.height : 838} fetchpriority="high" decoding="async" />
        </a>
        <figcaption class="hero-screen-note"><span class="capture-label"><span aria-hidden="true">↳</span> {t('Current interface · development preview.', 'Interface atual · prévia em desenvolvimento.')}</span><a href={path('/controle/')}>{t('Explore', 'Conhecer')} <span aria-hidden="true">→</span></a></figcaption>
      </figure>
    </div>
    <div class="home-container"><div class="home-metrics"><div><strong>63<span> /</span></strong><p>{t('Installer stages', 'Etapas de instalação')}</p></div><div><strong>07<span> /</span></strong><p>{t('Curated presets', 'Presets oficiais')}</p></div><div><strong>28<span> /</span></strong><p>{t('Independent Labs', 'Projetos no Labs')}</p></div><a href={githubUrl} target="_blank" rel="noopener noreferrer" class="source-metric"><BrandMark class="metric-mark"/><span>{t('Made to be explored.', 'Feito para explorar.')}<br/><strong>{t('Open source on GitHub', 'Código aberto no GitHub')} →</strong></span></a></div></div>
  </section>

  <section class="home-section home-container" id="recursos" aria-labelledby="control-heading">
    <div class="home-section-header"><div><p class="home-eyebrow">01 / CONTROL CENTER</p><h2 id="control-heading">{t('A little more clarity.', 'Mais clareza.')}<br/><span>{t('A lot more control.', 'Muito mais controle.')}</span></h2></div><p class="section-intro">{t('One terminal interface for installation and what comes after: module checks, package audits, portable profiles and configuration backups.', 'Uma interface no terminal para a instalação e o que vem depois: verificação de módulos, auditoria de pacotes, perfis portáteis e backup de configurações.')}</p></div>
    <div class="workflow-grid">{workflow.map(step => <article class="workflow-card"><div class="workflow-top"><span>{step.n}</span><span class="workflow-symbol" aria-hidden="true">{step.symbol}</span></div><h3>{step.title}</h3><p>{step.description}</p><code>{step.key}</code></article>)}</div>
    <div class="section-bottom"><p>{t('Topgrade and Arch-Update maintenance tools, with explicit confirmation before updates.', 'Manutenção com Topgrade e Arch-Update, com confirmação explícita antes de atualizar.')}</p><a class="text-link" href={path('/controle/')}>{t('Inside the Control Center', 'Por dentro do Control Center')} <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="presets-section" aria-labelledby="presets-heading"><div class="home-section home-container">
    <div class="home-section-header"><div><p class="home-eyebrow">02 / {t('CHOOSE YOUR START', 'ESCOLHA SEU COMEÇO')}</p><h2 id="presets-heading">{t('Six ways in.', 'Seis pontos de partida.')}<br/><span>{t('Your way forward.', 'O caminho é seu.')}</span></h2></div><p class="section-intro">{t('A preset is a selection, not a commitment. Inspect the plan, change what you need and review every stage before execution.', 'Um preset é uma seleção inicial. Inspecione o plano, ajuste o que precisar e revise cada etapa antes de executar.')}</p></div>
    <div class="preset-grid">{presets.map(preset => <article class:list={['preset-card', { 'preset-featured': preset.name === 'retro' }]}><div class="preset-top"><span class="preset-icon" aria-hidden="true">{preset.icon}</span><code>{preset.name}</code></div><p class="preset-tag">{preset.tag}</p><h3>{preset.title}</h3><p class="preset-description">{preset.description}</p><a href={path('/docs/')} class="preset-link" aria-label={t(`Read how to use the ${preset.name} preset`, `Saiba como usar o preset ${preset.name}`)}><code>--preset {preset.name}</code><span aria-hidden="true">→</span></a></article>)}</div>
  </div></section>

  <section class="home-section home-container" id="galeria" aria-labelledby="gallery-heading">
    <div class="home-section-header"><div><p class="home-eyebrow">03 / {t('THE VISUAL SIDE', 'O LADO VISUAL')}</p><h2 id="gallery-heading">{t('Less imagining.', 'Menos imaginar.')}<br/><span>{t('More seeing.', 'Mais ver de perto.')}</span></h2></div><p class="section-intro">{t('The current DarfinOS tools, alongside the independent projects that shape this setup. Open a screenshot to see the details.', 'As ferramentas atuais do DarfinOS e os projetos independentes que dão forma a essa proposta. Abra uma captura para ver os detalhes.')}</p></div>
    <div class="gallery-toolbar"><div class="gallery-filters" role="group" aria-label={t('Filter screenshots', 'Filtrar capturas')}>{filters.map(filter => <button type="button" data-gallery-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} class:list={['gallery-filter', { 'is-active': filter.id === 'all' }]}>{filter.label}</button>)}</div><p class="gallery-count mono" data-gallery-count role="status" aria-live="polite">{gallery.length} {t('images', 'imagens')}</p></div>
    <div class="home-gallery">{gallery.map(shot => <figure class="home-gallery-card" data-gallery-card data-category={category(shot)}><a href={shot.src} data-image-open data-image-title={shot.title} class="gallery-image-link" aria-label={`${t('Enlarge', 'Ampliar')}: ${shot.title}`}><img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" width={'width' in shot ? shot.width : 1600} height={'height' in shot ? shot.height : 1000}/><span class="enlarge-image" aria-hidden="true">→</span></a><figcaption><p class="home-eyebrow">{shot.label}</p><h3>{shot.title}</h3><p class="gallery-description">{shot.caption}</p><a class="text-link" href={shot.url} target="_blank" rel="noopener noreferrer">{shot.linkText} <span aria-hidden="true">→</span></a></figcaption></figure>)}</div>
    <p class="gallery-credit"><a class="text-link" href={labsRoute + (pt ? '#catalogo' : '#catalog')}>{t('Explore the Labs gallery', 'Explore a galeria do Labs')} →</a></p>
    <p class="gallery-credit">{t('Independent projects belong to their respective creators. Project images are references, not screenshots of an installed DarfinOS system.', 'Projetos independentes pertencem aos seus criadores. As imagens desses projetos são referências, não capturas de um sistema DarfinOS instalado.')}</p>
  </section>

  <section class="labs-banner home-container" id="labs" aria-labelledby="labs-heading"><div class="labs-panel"><div class="labs-visual" aria-hidden="true"><span>i3</span><span>95</span><span>~</span><BrandMark class="labs-mark"/></div><div class="labs-copy"><p class="home-eyebrow">04 / DARFINOS LABS</p><h2 id="labs-heading">{t('Curiosity is a feature.', 'Curiosidade também é recurso.')}</h2><p>{t('Tiling desktops, retro interfaces, portable environments and a few less ordinary Linux ideas. Independent projects, with a direct line to their creators.', 'Desktops em mosaico, interfaces retrô, ambientes portáteis e algumas ideias pouco convencionais para o Linux. Projetos independentes, com acesso direto aos seus criadores.')}</p><a class="text-link" href={path('/labs/')}>{t('Step into the lab', 'Entre no laboratório')} <span aria-hidden="true">→</span></a></div></div></section>

  <section class="home-section home-container start-section" id="downloads" aria-labelledby="start-heading"><p class="home-eyebrow">{t('YOUR NEXT COMMAND', 'SEU PRÓXIMO COMANDO')}</p><h2 id="start-heading">{t('Start with the source.', 'Comece pelo código.')}<br/><span>{t('Make it your own.', 'Deixe com a sua cara.')}</span></h2><p class="start-description">{t('Start from an existing Arch Linux installation. Read the guide, prepare your backups and explore the current development code. DarfinOS does not provide an ISO or a stable release yet.', 'Comece com uma instalação existente do Arch Linux. Leia o guia, prepare seus backups e explore o código em desenvolvimento. O DarfinOS ainda não oferece ISO ou release estável.')}</p><div class="start-actions"><a class="btn btn-primary" href={path('/docs/')}>{t('Open the installation guide', 'Abrir o guia de instalação')} <span aria-hidden="true">→</span></a><a class="btn btn-outline" href={sourceZipUrl}>{t('Download source ZIP', 'Baixar código ZIP')} <span aria-hidden="true">↓</span></a></div><div class="start-links"><a href={path('/downloads/')}>{t('Downloads & release status', 'Downloads e estado das versões')} →</a><span aria-hidden="true">/</span><a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer">{t('Questions or ideas? Open an issue', 'Dúvidas ou ideias? Abra uma issue')} →</a></div></section>

  <dialog class="image-dialog" aria-labelledby="image-dialog-title"><div class="dialog-inner"><div class="dialog-toolbar"><h2 id="image-dialog-title"></h2><button type="button" data-image-close aria-label={t('Close enlarged image', 'Fechar imagem ampliada')}>{t('Close', 'Fechar')} <span aria-hidden="true">×</span></button></div><img data-dialog-image src="/screenshots/tui.png" alt=""/></div></dialog>
</div>
<script>
const home = document.querySelector<HTMLElement>('[data-home-gallery]');
if (home) {
  const pt = home.dataset.locale === 'pt-BR';
  const controls = Array.from(home.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
  const cards = Array.from(home.querySelectorAll<HTMLElement>('[data-gallery-card]'));
  const count = home.querySelector<HTMLElement>('[data-gallery-count]');
  controls.forEach(control => control.addEventListener('click', () => {
    const filter = control.dataset.galleryFilter || 'all';
    let visible = 0;
    controls.forEach(button => { const active = button === control; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
    cards.forEach(card => { card.hidden = filter !== 'all' && card.dataset.category !== filter; if (!card.hidden) visible++; });
    if (count) count.textContent = `${visible} ${pt ? visible === 1 ? 'imagem' : 'imagens' : visible === 1 ? 'image' : 'images'}`;
  }));
  const dialog = home.querySelector<HTMLDialogElement>('.image-dialog');
  const image = home.querySelector<HTMLImageElement>('[data-dialog-image]');
  const title = home.querySelector<HTMLElement>('#image-dialog-title');
  if (dialog && image && title && typeof dialog.showModal === 'function') {
    home.querySelectorAll<HTMLAnchorElement>('[data-image-open]').forEach(link => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt || link.dataset.imageTitle || '';
      title.textContent = link.dataset.imageTitle || 'DarfinOS';
      dialog.showModal();
      document.body.classList.add('image-dialog-open');
    }));
    home.querySelector('[data-image-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => document.body.classList.remove('image-dialog-open'));
  }
}
</script>
<style>
.home{--home-muted:#a6adb9;--home-line:#292e35;--home-surface:#12151a;--home-yellow:#ffd22f;overflow:hidden}
.home-container{max-width:1200px;margin-inline:auto;padding-inline:24px}
.home-eyebrow{font:600 .65rem/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.12em;color:var(--home-yellow);text-transform:uppercase}
.home-hero{position:relative;background:radial-gradient(ellipse at 81% 20%,#ffd22f08,transparent 60%)}
.hero-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:45px;padding-top:88px;padding-bottom:72px}
.hero-copy>.home-eyebrow{display:flex;align-items:center;gap:9px;margin-bottom:27px}
.status-dot{display:block;width:6px;height:6px;border-radius:100%;background:var(--home-yellow);box-shadow:0 0 0 4px #ffd22f12;flex-shrink:0}
h1{font-size:clamp(3rem,6.1vw,5.5rem);line-height:1.03;font-weight:800;letter-spacing:-.065em}h1>span{color:var(--home-yellow)}
.hero-description{font-size:1rem;line-height:1.8;color:#bdc3ce;max-width:445px;margin-top:26px}
.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:23px;margin-top:31px}
.hero-guide{font-size:.82rem;font-weight:600;display:inline-flex;align-items:center;gap:12px}.hero-guide:hover{color:var(--home-yellow)}
.hero-disclaimer{font-size:.69rem;color:#939ba9;margin-top:23px;line-height:1.7;max-width:380px}
.hero-screen{min-width:0;position:relative}.hero-screen::before{content:'';position:absolute;inset:12% -30% -12%;border-radius:50%;background:radial-gradient(ellipse,#ffd22f0b,transparent 68%);pointer-events:none;z-index:-1}
.screen-caption{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.screen-caption>.home-eyebrow{font-size:.58rem;letter-spacing:.1em}
.screen-status{font:500 .56rem ui-monospace,Consolas,monospace;color:#969da9;border:1px solid #3b4048;padding:4px 7px;border-radius:4px}
.screen-window{display:block;border:1px solid #41434a;border-radius:11px;overflow:hidden;background:#0b0d10;box-shadow:0 28px 70px #0005;transition:border-color .2s,transform .2s}.screen-window:hover{border-color:#ffd22f88;transform:translateY(-3px)}
.window-bar{height:34px;background:#1d2127;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 12px;border-bottom:1px solid #343941;color:#949ba8;font:500 .55rem ui-monospace,Consolas,monospace}
.window-dots{display:flex;gap:5px}.window-dots i{height:6px;width:6px;border-radius:50%;display:block;background:#626975}.window-dots i:first-child{background:#e57972}.window-dots i:nth-child(2){background:#dfb865}.window-dots i:last-child{background:#84b092}
.screen-window img{display:block;width:100%;height:auto;aspect-ratio:8/5;object-fit:contain;background:#0b0d10}
.hero-screen-note{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-top:14px;font-size:.6rem;color:#909aa9;line-height:1.6}.hero-screen-note a{color:#cdd2db;white-space:nowrap}.hero-screen-note a:hover{color:var(--home-yellow)}.capture-label>span{color:var(--home-yellow);margin-right:3px}
.home-metrics{display:grid;grid-template-columns:repeat(3,1fr) 1.5fr;gap:24px;border-block:1px solid var(--home-line);padding-block:27px}.home-metrics>div{padding-left:16px;border-left:1px solid var(--home-line)}.home-metrics>div:first-child{border:0;padding-left:0}.home-metrics>div>strong{font:650 1.9rem/1.2 ui-monospace,Consolas,monospace;letter-spacing:-.05em}.home-metrics>div>strong>span{font-size:1rem;color:#505866}.home-metrics p{font-size:.68rem;color:var(--home-muted);margin-top:6px}
.source-metric{display:flex;gap:14px;align-items:center;justify-content:flex-end;font-size:.69rem;line-height:1.9;color:var(--home-muted)}.source-metric strong{font-size:.73rem;font-weight:600;color:#e4e8ef}.source-metric:hover strong{color:var(--home-yellow)}:global(.metric-mark){width:36px;height:36px;color:var(--home-yellow);flex-shrink:0}
.home-section{padding-top:90px;padding-bottom:88px}.home-section-header{display:grid;grid-template-columns:1fr .8fr;align-items:end;gap:50px;margin-bottom:33px}.home-section-header .home-eyebrow{margin-bottom:15px}.home h2{font-size:clamp(2rem,3.25vw,3rem);font-weight:750;letter-spacing:-.055em;line-height:1.14}.home h2>span{color:#858e9d}.section-intro{font-size:.86rem;line-height:1.85;color:var(--home-muted);max-width:430px;padding-bottom:4px}
.workflow-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.workflow-card{border:1px solid var(--home-line);border-radius:10px;background:linear-gradient(130deg,#181c23,#111419);padding:25px;min-width:0;display:flex;flex-direction:column}.workflow-top{display:flex;justify-content:space-between;align-items:center;font:500 .62rem ui-monospace,Consolas,monospace;color:#929dab;margin-bottom:28px}.workflow-symbol{display:grid;place-items:center;width:32px;height:32px;color:var(--home-yellow);border:1px solid #ffd22f33;border-radius:7px;font-size:1.2rem;background:#ffd22f06}.workflow-card h3{font-size:1.05rem;font-weight:650;letter-spacing:-.03em;line-height:1.4;margin-bottom:12px}.workflow-card>p{font-size:.78rem;line-height:1.8;color:var(--home-muted);margin-bottom:22px;flex:1}.workflow-card>code{font:.67rem/1.5 ui-monospace,Consolas,monospace;color:#c1c9d7;background:#0b0e12;border:1px solid #292e38;padding:10px 12px;border-radius:5px;overflow-wrap:anywhere}
.section-bottom{display:flex;justify-content:space-between;align-items:flex-start;gap:35px;margin-top:22px}.section-bottom>p{font-size:.69rem;color:#8e98a7;max-width:580px;line-height:1.8}.text-link{display:inline-flex;align-items:center;gap:12px;color:var(--home-yellow);font-size:.74rem;font-weight:600;line-height:1.5}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.section-bottom>.text-link{flex-shrink:0}
